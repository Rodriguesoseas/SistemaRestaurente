<% content_for :title, "Detalhes da movimentação" %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Financeiro</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest">Detalhes da movimentação</h1>
    <p class="mt-2 text-sm leading-6 text-stone-500"><%= @movimentacao.descricao %></p>
  </div>
  <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold <%= @movimentacao.entrada? ? 'bg-emerald-100 text-emerald-900' : 'bg-red-100 text-red-900' %>"><%= @movimentacao.entrada? ? "ENTRADA" : "SAÍDA" %></span>
</div>

<section class="max-w-2xl rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
  <dl class="space-y-3 text-sm">
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Valor</dt><dd class="text-right text-lg font-bold <%= @movimentacao.entrada? ? 'text-emerald-700' : 'text-red-700' %>"><%= number_to_currency(@movimentacao.valor) %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Categoria</dt><dd class="text-right font-medium"><%= @movimentacao.categoria_financeira.nome %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Pagamento</dt><dd class="text-right font-medium"><%= @movimentacao.forma_pagamento_rotulo %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Data e hora</dt><dd class="text-right font-medium"><%= l(@movimentacao.ocorrido_em) %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Responsável</dt><dd class="text-right font-medium"><%= @movimentacao.user.email %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Caixa</dt><dd class="text-right font-medium">Aberto em <%= l(@movimentacao.caixa.aberto_em) %></dd></div>
  </dl>
</section>

<div class="mt-8 flex flex-wrap gap-3">
  <%= link_to "Voltar às movimentações", movimentacao_financeiras_path, class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
  <%= link_to "Ver caixa", caixa_path(@movimentacao.caixa), class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
</div>
