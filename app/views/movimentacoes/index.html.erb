<% content_for :title, "Movimentações" %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Financeiro</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest">Movimentações</h1>
    <p class="mt-2 text-sm leading-6 text-stone-500">Entradas e saídas registradas nos caixas.</p>
  </div>
  <%= link_to "NOVA MOVIMENTAÇÃO", new_movimentacao_financeira_path, class: "primary-button inline-flex items-center" %>
</div>

<dl class="grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Totais do filtro atual">
  <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Entradas</dt>
    <dd class="mt-2 text-2xl font-semibold text-emerald-700"><%= number_to_currency(@total_entradas) %></dd>
  </div>
  <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Saídas</dt>
    <dd class="mt-2 text-2xl font-semibold text-red-700"><%= number_to_currency(@total_saidas) %></dd>
  </div>
  <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Resultado</dt>
    <dd class="mt-2 text-2xl font-semibold text-stone-800"><%= number_to_currency(@resultado) %></dd>
  </div>
</dl>

<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" aria-label="Filtros">
  <%= form_with url: movimentacao_financeiras_path, method: :get, class: "grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" do |f| %>
    <div>
      <%= f.label :tipo, "Tipo", class: "form-label" %>
      <%= f.select :tipo, options_for_select([ [ "Todos", "" ], [ "Entradas", "entrada" ], [ "Saídas", "saida" ] ], @filtros[:tipo]), {}, class: "form-input" %>
    </div>
    <div>
      <%= f.label :categoria_id, "Categoria", class: "form-label" %>
      <%= f.select :categoria_id, options_for_select([ [ "Todas", "" ] ] + @categorias.map { |c| [ "#{c.nome} (#{CategoriaFinanceira.rotulo_tipo(c.tipo)})", c.id ] }, @filtros[:categoria_id]), {}, class: "form-input" %>
    </div>
    <div>
      <%= f.label :forma_pagamento, "Pagamento", class: "form-label" %>
      <%= f.select :forma_pagamento, options_for_select([ [ "Todos", "" ] ] + MovimentacaoFinanceira::ROTULOS_FORMA_PAGAMENTO.map { |valor, rotulo| [ rotulo, valor ] }, @filtros[:forma_pagamento]), {}, class: "form-input" %>
    </div>
    <div class="flex items-end gap-3">
      <%= f.submit "FILTRAR", class: "primary-button" %>
      <%= link_to "Limpar", movimentacao_financeiras_path, class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
    </div>
  <% end %>
</section>

<section class="mt-6" aria-label="Lista de movimentações">
  <% if @movimentacoes.any? %>
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
          <thead class="bg-stone-50 text-left text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Data</th>
              <th class="px-4 py-3 font-medium">Descrição</th>
              <th class="px-4 py-3 font-medium">Categoria</th>
              <th class="px-4 py-3 font-medium">Pagamento</th>
              <th class="px-4 py-3 text-right font-medium">Valor</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @movimentacoes.each do |movimentacao| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3"><%= l(movimentacao.ocorrido_em) %></td>
                <td class="px-4 py-3">
                  <span class="font-medium text-stone-800"><%= movimentacao.descricao %></span>
                  <span class="ml-2 inline-flex rounded-full px-2 py-0.5 text-xs font-semibold <%= movimentacao.entrada? ? 'bg-emerald-50 text-emerald-800' : 'bg-red-50 text-red-800' %>"><%= movimentacao.entrada? ? "Entrada" : "Saída" %></span>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= movimentacao.categoria_financeira.nome %></td>
                <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= movimentacao.forma_pagamento_rotulo %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right font-semibold <%= movimentacao.entrada? ? 'text-emerald-700' : 'text-red-700' %>"><%= number_to_currency(movimentacao.valor) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= link_to "VER", movimentacao_financeira_path(movimentacao), class: "table-link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">Nenhuma movimentação encontrada para os filtros selecionados.</p>
  <% end %>
</section>
