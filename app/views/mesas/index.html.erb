<% content_for :title, "Mesas" %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Salão</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest">Mesas</h1>
    <p class="mt-2 text-sm leading-6 text-stone-500">Ocupação, comandas e histórico por mesa.</p>
  </div>
  <%= link_to "NOVA MESA", new_mesa_path, class: "primary-button inline-flex items-center" %>
</div>

<section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Mesas">
  <% if @mesas.any? %>
    <% @mesas.each do |mesa| %>
      <article class="rounded-2xl border bg-white p-5 shadow-sm sm:p-6 <%= mesa.ocupada? ? 'border-amber-300' : 'border-stone-200' %>">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-lg font-bold text-forest">Mesa <%= mesa.numero %><%= " · #{mesa.nome}" if mesa.nome.present? %></h2>
          <% if mesa.ocupada? %>
            <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900">OCUPADA</span>
          <% elsif mesa.ativo? %>
            <span class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800">LIVRE</span>
          <% else %>
            <span class="inline-flex rounded-full bg-stone-100 px-3 py-1 text-xs font-bold text-stone-600">INATIVA</span>
          <% end %>
        </div>
        <% if mesa.ocupada? %>
          <p class="mt-3 text-sm text-stone-600">Comanda aberta às <%= l(mesa.comanda_aberta.aberta_em, format: :short) %> · <%= number_to_currency(mesa.comanda_aberta.valor_total) %></p>
          <div class="mt-4 flex flex-wrap gap-2">
            <%= link_to "VER COMANDA", comanda_path(mesa.comanda_aberta), class: "inline-flex min-h-11 items-center rounded-xl bg-forest px-4 py-2 text-xs font-bold text-white hover:bg-emerald-900" %>
          </div>
        <% elsif mesa.ativo? %>
          <div class="mt-4">
            <%= button_to "ABRIR COMANDA", comandas_path(mesa_id: mesa.id), method: :post, class: "inline-flex min-h-11 items-center rounded-xl border border-stone-300 px-4 py-2 text-xs font-bold text-stone-700 hover:bg-stone-50", form: { data: { turbo_confirm: "Abrir comanda para a Mesa #{mesa.numero}?" } } %>
          </div>
        <% end %>
        <div class="mt-4 flex gap-4 border-t border-stone-100 pt-3 text-xs">
          <%= link_to "Detalhes", mesa_path(mesa), class: "table-link" %>
          <%= link_to "Editar", edit_mesa_path(mesa), class: "table-link" %>
        </div>
      </article>
    <% end %>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500 sm:col-span-2 xl:col-span-3">Nenhuma mesa cadastrada.</p>
  <% end %>
</section>
