<% content_for :title, "Detalhes do caixa" %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Caixa</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest">Detalhes do caixa</h1>
    <p class="mt-2 text-sm leading-6 text-stone-500">Aberto em <%= l(@caixa.aberto_em) %> por <%= @caixa.user.email %>.</p>
  </div>
  <%= render "status", caixa: @caixa %>
</div>

<%= render "caixa_atual", caixa: @caixa %>

<section class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-forest">Abertura e fechamento</h2>
    <dl class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Abertura</dt><dd class="text-right font-medium"><%= l(@caixa.aberto_em) %></dd></div>
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Responsável pela abertura</dt><dd class="text-right font-medium"><%= @caixa.user.email %></dd></div>
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Fechamento</dt><dd class="text-right font-medium"><%= @caixa.fechado_em ? l(@caixa.fechado_em) : "—" %></dd></div>
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Responsável pelo fechamento</dt><dd class="text-right font-medium"><%= @caixa.fechamento_user&.email || "—" %></dd></div>
    </dl>
  </div>

  <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-forest">Conferência de dinheiro</h2>
    <dl class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Esperado</dt><dd class="text-right font-medium"><%= @caixa.valor_esperado_dinheiro.nil? ? "—" : number_to_currency(@caixa.valor_esperado_dinheiro) %></dd></div>
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Contado</dt><dd class="text-right font-medium"><%= @caixa.valor_contado.nil? ? "—" : number_to_currency(@caixa.valor_contado) %></dd></div>
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Diferença</dt><dd class="text-right font-semibold <%= @caixa.diferenca&.negative? ? 'text-red-700' : 'text-emerald-700' %>"><%= @caixa.diferenca.nil? ? "—" : number_to_currency(@caixa.diferenca) %></dd></div>
    </dl>
  </div>
</section>

<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold text-forest">Formas de pagamento (entradas)</h2>
  <% totais_pagamento = @caixa.totais_entradas_por_pagamento %>
  <div class="mt-4 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="text-left text-xs uppercase tracking-wider text-stone-500">
        <tr><th class="py-2 font-medium">Forma</th><th class="py-2 text-right font-medium">Total</th></tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% MovimentacaoFinanceira::FORMAS_EXPLICITAS.each do |forma| %>
          <tr>
            <td class="py-2 text-stone-600"><%= MovimentacaoFinanceira::ROTULOS_FORMA_PAGAMENTO.fetch(forma) %></td>
            <td class="py-2 text-right text-stone-800"><%= number_to_currency(totais_pagamento.fetch(forma, 0)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" aria-label="Movimentações deste caixa">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-lg font-semibold text-forest">Movimentações deste caixa</h2>
    <% if @caixa.aberto? %>
      <%= link_to "NOVA MOVIMENTAÇÃO", new_movimentacao_financeira_path, class: "text-sm table-link" %>
    <% end %>
  </div>
  <% if @movimentacoes.any? %>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-left text-xs uppercase tracking-wider text-stone-500">
          <tr><th class="py-2 font-medium">Data</th><th class="py-2 font-medium">Descrição</th><th class="py-2 font-medium">Categoria</th><th class="py-2 text-right font-medium">Valor</th></tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @movimentacoes.each do |movimentacao| %>
            <tr>
              <td class="whitespace-nowrap py-2 text-stone-600"><%= l(movimentacao.ocorrido_em) %></td>
              <td class="py-2 text-stone-800"><%= movimentacao.descricao %></td>
              <td class="whitespace-nowrap py-2 text-stone-600"><%= movimentacao.categoria_financeira.nome %></td>
              <td class="whitespace-nowrap py-2 text-right font-semibold <%= movimentacao.entrada? ? 'text-emerald-700' : 'text-red-700' %>"><%= number_to_currency(movimentacao.valor) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-stone-500">Nenhuma movimentação registrada neste caixa.</p>
  <% end %>
</section>

<div class="mt-8">
  <%= link_to "Voltar ao caixa", caixas_path, class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
</div>