<section class="rounded-2xl border border-emerald-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="caixa-atual">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <span class="flex size-11 items-center justify-center rounded-xl bg-forest text-amber-300" aria-hidden="true"><%= icon("cash") %></span>
        <div>
          <h2 id="caixa-atual" class="text-lg font-semibold text-forest">Caixa atual</h2>
          <p class="text-sm text-stone-500">Aberto em <%= l(caixa.aberto_em) %> por <%= caixa.user.email %></p>
        </div>
      </div>
    </div>
    <%= render "status", caixa: caixa %>
  </div>

  <dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-xl border border-stone-200 p-4">
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Saldo inicial</dt>
      <dd class="mt-2 text-2xl font-semibold text-stone-800"><%= number_to_currency(caixa.saldo_inicial) %></dd>
    </div>
    <div class="rounded-xl border border-stone-200 p-4">
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Entradas</dt>
      <dd class="mt-2 text-2xl font-semibold text-emerald-700"><%= number_to_currency(caixa.entradas) %></dd>
    </div>
    <div class="rounded-xl border border-stone-200 p-4">
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Saídas</dt>
      <dd class="mt-2 text-2xl font-semibold text-red-700"><%= number_to_currency(caixa.saidas) %></dd>
    </div>
    <div class="rounded-xl border border-stone-200 p-4">
      <dt class="text-xs font-medium uppercase tracking-wider text-stone-500">Resultado atual</dt>
      <dd class="mt-2 text-2xl font-semibold text-stone-800"><%= number_to_currency(caixa.resultado) %></dd>
    </div>
  </dl>

  <div class="mt-6 rounded-xl bg-stone-50 p-4 text-sm text-stone-600">
    <p>Saldo consolidado: <strong class="text-stone-900"><%= number_to_currency(caixa.saldo_consolidado) %></strong></p>
    <p class="mt-1">Dinheiro esperado na conferência: <strong class="text-stone-900"><%= number_to_currency(caixa.dinheiro_esperado) %></strong></p>
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <%= link_to "NOVA MOVIMENTAÇÃO", new_movimentacao_financeira_path, class: "inline-flex min-h-12 items-center rounded-xl bg-forest px-5 py-3 text-sm font-bold text-white hover:bg-emerald-900" %>
    <%= link_to "VER DETALHES", caixa_path(caixa), class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
    <%= link_to "FECHAR CAIXA", fechar_caixa_path(caixa), class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
  </div>
</section>