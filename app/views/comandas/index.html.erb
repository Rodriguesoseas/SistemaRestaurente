<% content_for :title, "Comandas" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Salão</p>
  <h1 class="text-3xl font-bold tracking-tight text-forest">Comandas</h1>
  <p class="mt-2 text-sm leading-6 text-stone-500">Abertas e encerradas, com responsáveis e valores.</p>
</div>

<section class="mb-6 flex flex-wrap gap-2" aria-label="Filtro por status">
  <% [[ "Todas", nil ], [ "Abertas", "aberta" ], [ "Fechadas", "fechada" ]].each do |rotulo, valor| %>
    <%= link_to rotulo.upcase, comandas_path(status: valor), class: "inline-flex min-h-11 items-center rounded-xl px-4 py-2 text-xs font-bold #{@filtro_status == valor ? 'bg-forest text-white' : 'border border-stone-300 text-stone-700 hover:bg-stone-50'}" %>
  <% end %>
</section>

<section aria-label="Histórico de comandas">
  <% if @comandas.any? %>
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
          <thead class="bg-stone-50 text-left text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Mesa</th>
              <th class="px-4 py-3 font-medium">Abertura</th>
              <th class="px-4 py-3 text-right font-medium">Total</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @comandas.each do |comanda| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3 font-medium">Mesa <%= comanda.mesa.numero %></td>
                <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= l(comanda.aberta_em) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= number_to_currency(comanda.valor_total) %></td>
                <td class="whitespace-nowrap px-4 py-3">
                  <% if comanda.aberta? %>
                    <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">Aberta</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-stone-100 px-2 py-0.5 text-xs font-semibold text-stone-600">Fechada</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= link_to "VER", comanda_path(comanda), class: "table-link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">Nenhuma comanda encontrada.</p>
  <% end %>
</section>
