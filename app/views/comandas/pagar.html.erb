<% content_for :title, "Pagar comanda" %>
<div class="mb-8">
  <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Salão · Mesa <%= @comanda.mesa.numero %></p>
  <h1 class="text-3xl font-bold tracking-tight text-forest">Pagar comanda</h1>
  <p class="mt-2 text-sm leading-6 text-stone-500">O pagamento cria uma entrada no caixa atual e libera a mesa. Não é possível desfazer por aqui.</p>
</div>

<section class="max-w-xl space-y-6">
  <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-forest">Resumo</h2>
    <dl class="mt-4 space-y-2 text-sm">
      <% @comanda.item_comandas.order(:id).each do |item| %>
        <div class="flex justify-between gap-4">
          <dt class="text-stone-600"><%= number_with_precision(item.quantidade, precision: 3, strip_insignificant_zeros: true) %> × <%= item.descricao %></dt>
          <dd class="font-medium"><%= number_to_currency(item.subtotal) %></dd>
        </div>
      <% end %>
      <div class="flex justify-between gap-4 border-t border-stone-200 pt-3">
        <dt class="font-semibold text-stone-700">Total</dt>
        <dd class="text-lg font-bold text-forest"><%= number_to_currency(@comanda.valor_total) %></dd>
      </div>
    </dl>
  </div>

  <%= form_with url: confirmar_pagamento_comanda_path(@comanda), method: :patch, class: "rounded-2xl border border-stone-200 bg-white p-6 shadow-sm space-y-5" do |f| %>
    <div>
      <%= f.label :forma_pagamento, "Forma de pagamento", class: "form-label" %>
      <%= f.select :forma_pagamento, options_for_select(MovimentacaoFinanceira::ROTULOS_FORMA_PAGAMENTO.except("nao_informada").map { |valor, rotulo| [ rotulo, valor ] }), { prompt: "Selecione" }, class: "form-input", name: "comanda[forma_pagamento]" %>
    </div>

    <div class="rounded-xl bg-stone-50 p-4 text-sm text-stone-600">
      <p><strong class="text-stone-900">Responsável:</strong> <%= current_user.email %></p>
      <p class="mt-1"><strong class="text-stone-900">Categoria:</strong> Venda (entrada automática)</p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= f.submit "CONFIRMAR PAGAMENTO", class: "primary-button", data: { turbo_confirm: "Confirma o pagamento desta comanda?" } %>
      <%= link_to "Voltar", comanda_path(@comanda), class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
    </div>
  <% end %>
</section>
