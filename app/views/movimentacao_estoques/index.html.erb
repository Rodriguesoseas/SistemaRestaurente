<% content_for :title, "Estoque" %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Almoxarifado</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest">Estoque</h1>
    <p class="mt-2 text-sm leading-6 text-stone-500">Saldos, entradas e saídas manuais. Pedidos das comandas não baixam o estoque.</p>
  </div>
  <%= link_to "NOVA MOVIMENTAÇÃO", new_movimentacao_estoque_path, class: "primary-button inline-flex items-center" %>
</div>

<section aria-label="Saldos em estoque">
  <h2 class="mb-4 text-lg font-semibold text-forest">Saldos</h2>
  <% if @produtos.any? %>
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
          <thead class="bg-stone-50 text-left text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Produto</th>
              <th class="px-4 py-3 text-right font-medium">Saldo</th>
              <th class="px-4 py-3 text-right font-medium">Mínimo</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @produtos.each do |produto| %>
              <tr>
                <td class="px-4 py-3 font-medium text-stone-800"><%= produto.nome %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= number_with_precision(produto.quantidade_atual, precision: 3, strip_insignificant_zeros: true) %> <%= produto.unidade_rotulo.downcase %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-stone-600"><%= number_with_precision(produto.estoque_minimo, precision: 3, strip_insignificant_zeros: true) %></td>
                <td class="whitespace-nowrap px-4 py-3">
                  <% case produto.estoque_status %>
                  <% when :sem_estoque %>
                    <span class="inline-flex rounded-full bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-800">Sem estoque</span>
                  <% when :baixo %>
                    <span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-800">Estoque baixo</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-800">Normal</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= link_to "VER", produto_path(produto), class: "table-link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">Nenhum produto cadastrado.</p>
  <% end %>
</section>

<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" aria-label="Filtros">
  <%= form_with url: movimentacao_estoques_path, method: :get, class: "grid grid-cols-1 gap-4 sm:grid-cols-3" do |f| %>
    <div>
      <%= f.label :tipo, "Tipo", class: "form-label" %>
      <%= f.select :tipo, options_for_select([ [ "Todos", "" ], [ "Entradas", "entrada" ], [ "Saídas", "saida" ] ], @filtros[:tipo]), {}, class: "form-input" %>
    </div>
    <div>
      <%= f.label :produto_id, "Produto", class: "form-label" %>
      <%= f.select :produto_id, options_for_select([ [ "Todos", "" ] ] + @produtos_filtro.map { |p| [ p.nome, p.id ] }, @filtros[:produto_id]), {}, class: "form-input" %>
    </div>
    <div class="flex items-end gap-3">
      <%= f.submit "FILTRAR", class: "primary-button" %>
      <%= link_to "Limpar", movimentacao_estoques_path, class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
    </div>
  <% end %>
</section>

<section class="mt-6" aria-label="Movimentações de estoque">
  <h2 class="mb-4 text-lg font-semibold text-forest">Movimentações</h2>
  <% if @movimentacoes.any? %>
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
          <thead class="bg-stone-50 text-left text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Data</th>
              <th class="px-4 py-3 font-medium">Produto</th>
              <th class="px-4 py-3 font-medium">Motivo</th>
              <th class="px-4 py-3 text-right font-medium">Quantidade</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @movimentacoes.each do |movimentacao| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3"><%= l(movimentacao.ocorrido_em) %></td>
                <td class="px-4 py-3">
                  <span class="font-medium text-stone-800"><%= movimentacao.produto.nome %></span>
                  <span class="ml-2 inline-flex rounded-full px-2 py-0.5 text-xs font-semibold <%= movimentacao.entrada? ? 'bg-emerald-50 text-emerald-800' : 'bg-red-50 text-red-800' %>"><%= movimentacao.entrada? ? "Entrada" : "Saída" %></span>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= movimentacao.motivo_rotulo %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right font-semibold <%= movimentacao.entrada? ? 'text-emerald-700' : 'text-red-700' %>"><%= movimentacao.entrada? ? "+" : "−" %><%= number_with_precision(movimentacao.quantidade, precision: 3, strip_insignificant_zeros: true) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= link_to "VER", movimentacao_estoque_path(movimentacao), class: "table-link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">Nenhuma movimentação encontrada para os filtros selecionados.</p>
  <% end %>
</section>
