<% content_for :title, "Detalhes da movimentação de estoque" %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Almoxarifado</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest">Detalhes da movimentação</h1>
    <p class="mt-2 text-sm leading-6 text-stone-500"><%= @movimentacao.produto.nome %></p>
  </div>
  <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold <%= @movimentacao.entrada? ? 'bg-emerald-100 text-emerald-900' : 'bg-red-100 text-red-900' %>"><%= @movimentacao.entrada? ? "ENTRADA" : "SAÍDA" %></span>
</div>

<section class="max-w-2xl rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
  <dl class="space-y-3 text-sm">
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Quantidade</dt><dd class="text-right text-lg font-bold <%= @movimentacao.entrada? ? 'text-emerald-700' : 'text-red-700' %>"><%= @movimentacao.entrada? ? "+" : "−" %><%= number_with_precision(@movimentacao.quantidade, precision: 3, strip_insignificant_zeros: true) %> <%= @movimentacao.produto.unidade_rotulo.downcase %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Motivo</dt><dd class="text-right font-medium"><%= @movimentacao.motivo_rotulo %></dd></div>
    <% if @movimentacao.observacao.present? %>
      <div class="flex justify-between gap-4"><dt class="text-stone-500">Observação</dt><dd class="text-right font-medium"><%= @movimentacao.observacao %></dd></div>
    <% end %>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Data e hora</dt><dd class="text-right font-medium"><%= l(@movimentacao.ocorrido_em) %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Responsável</dt><dd class="text-right font-medium"><%= @movimentacao.user.email %></dd></div>
  </dl>
</section>

<div class="mt-8 flex flex-wrap gap-3">
  <%= link_to "Voltar ao estoque", movimentacao_estoques_path, class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
  <%= link_to "Ver produto", produto_path(@movimentacao.produto), class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
</div>
