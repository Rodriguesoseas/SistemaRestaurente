<% content_for :title, @produto.nome %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Cardápio e estoque</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest"><%= @produto.nome %></h1>
    <p class="mt-2 text-sm leading-6 text-stone-500"><%= @produto.categoria_produto.nome %> · por <%= @produto.unidade_rotulo.downcase %></p>
  </div>
  <%= link_to "EDITAR", edit_produto_path(@produto), class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
</div>

<section class="max-w-2xl rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
  <dl class="space-y-3 text-sm">
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Preço de venda</dt><dd class="text-right font-bold"><%= @produto.preco_venda.nil? ? "—" : number_to_currency(@produto.preco_venda) %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Preço de custo</dt><dd class="text-right font-medium"><%= @produto.preco_custo.nil? ? "—" : number_to_currency(@produto.preco_custo) %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Disponível para venda</dt><dd class="text-right font-medium"><%= @produto.disponivel_venda? ? "Sim" : "Não" %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Ativo</dt><dd class="text-right font-medium"><%= @produto.ativo? ? "Sim" : "Não" %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Saldo em estoque</dt><dd class="text-right font-medium"><%= number_with_precision(@produto.quantidade_atual, precision: 3, strip_insignificant_zeros: true) %> <%= @produto.unidade_rotulo.downcase %></dd></div>
    <div class="flex justify-between gap-4"><dt class="text-stone-500">Estoque mínimo</dt><dd class="text-right font-medium"><%= number_with_precision(@produto.estoque_minimo, precision: 3, strip_insignificant_zeros: true) %></dd></div>
  </dl>
</section>

<div class="mt-8 flex flex-wrap gap-3">
  <%= link_to "Voltar aos produtos", produtos_path, class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
  <%= link_to "Movimentar estoque", new_movimentacao_estoque_path, class: "inline-flex min-h-12 items-center rounded-xl bg-forest px-5 py-3 text-sm font-bold text-white hover:bg-emerald-900" %>
</div>

<section class="mt-8 max-w-2xl" aria-label="Histórico de estoque">
  <h2 class="mb-4 text-lg font-semibold text-forest">Histórico de estoque</h2>
  <% if @movimentacoes_estoque.any? %>
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
          <thead class="bg-stone-50 text-left text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Data</th>
              <th class="px-4 py-3 font-medium">Tipo</th>
              <th class="px-4 py-3 text-right font-medium">Qtd</th>
              <th class="px-4 py-3 font-medium">Motivo</th>
              <th class="px-4 py-3 font-medium">Responsável</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @movimentacoes_estoque.each do |movimentacao| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3"><%= l(movimentacao.ocorrido_em) %></td>
                <td class="whitespace-nowrap px-4 py-3"><%= movimentacao.entrada? ? "Entrada" : "Saída" %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right font-semibold <%= movimentacao.entrada? ? 'text-emerald-700' : 'text-red-700' %>"><%= movimentacao.entrada? ? "+" : "−" %><%= number_with_precision(movimentacao.quantidade, precision: 3, strip_insignificant_zeros: true) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= movimentacao.motivo_rotulo %></td>
                <td class="px-4 py-3 text-stone-600"><%= movimentacao.user.email %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">Nenhuma movimentação de estoque para este produto.</p>
  <% end %>
</section>
