<%= form_with model: produto, class: "space-y-5" do |f| %>
  <% if produto.errors.any? %>
    <div role="alert" class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">
      <p class="font-medium">Não foi possível salvar o produto:</p>
      <ul class="mt-1 list-inside list-disc">
        <% produto.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :nome, "Nome", class: "form-label" %>
    <%= f.text_field :nome, required: true, maxlength: 255, placeholder: "Ex.: Espeto de carne", class: "form-input" %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :categoria_produto_id, "Categoria", class: "form-label" %>
      <%= f.collection_select :categoria_produto_id, CategoriaProduto.ordenadas, :id, :nome, { prompt: "Selecione" }, class: "form-input" %>
    </div>
    <div>
      <%= f.label :unidade, "Unidade", class: "form-label" %>
      <%= f.select :unidade, Produto::ROTULOS_UNIDADE.map { |valor, rotulo| [ rotulo, valor ] }, {}, class: "form-input" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :preco_venda, "Preço de venda (R$)", class: "form-label" %>
      <%= f.number_field :preco_venda, step: "0.01", min: 0, inputmode: "decimal", class: "form-input" %>
      <p class="mt-2 text-xs text-stone-500">Obrigatório quando disponível para venda.</p>
    </div>
    <div>
      <%= f.label :preco_custo, "Preço de custo (R$, opcional)", class: "form-label" %>
      <%= f.number_field :preco_custo, step: "0.01", min: 0, inputmode: "decimal", class: "form-input" %>
    </div>
  </div>

  <div>
    <%= f.label :estoque_minimo, "Estoque mínimo", class: "form-label" %>
    <%= f.number_field :estoque_minimo, step: "0.001", min: 0, inputmode: "decimal", class: "form-input" %>
  </div>

  <div class="space-y-3 rounded-xl bg-stone-50 p-4 text-sm">
    <label class="flex min-h-11 items-center gap-3 text-stone-700">
      <%= f.check_box :disponivel_venda, class: "size-5 rounded border-stone-300" %> Disponível para venda
    </label>
    <label class="flex min-h-11 items-center gap-3 text-stone-700">
      <%= f.check_box :ativo, class: "size-5 rounded border-stone-300" %> Produto ativo
    </label>
    <p class="text-xs text-stone-500">Produtos inativos ou fora de venda não entram em novos pedidos, mas permanecem no histórico. Para retirar de linha, desmarque "ativo" em vez de excluir.</p>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= f.submit produto.persisted? ? "SALVAR" : "CADASTRAR", class: "primary-button" %>
    <%= link_to "Cancelar", produtos_path, class: "inline-flex min-h-12 items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
  </div>
<% end %>
