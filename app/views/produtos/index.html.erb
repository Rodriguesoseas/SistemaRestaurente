<% content_for :title, "Produtos" %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700">Cardápio e estoque</p>
    <h1 class="text-3xl font-bold tracking-tight text-forest">Produtos</h1>
    <p class="mt-2 text-sm leading-6 text-stone-500">Preços de venda, disponibilidade e categorias.</p>
  </div>
  <%= link_to "NOVO PRODUTO", new_produto_path, class: "primary-button inline-flex items-center" %>
</div>

<section aria-label="Lista de produtos">
  <% if @produtos.any? %>
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
          <thead class="bg-stone-50 text-left text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Produto</th>
              <th class="px-4 py-3 font-medium">Categoria</th>
              <th class="px-4 py-3 text-right font-medium">Preço</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @produtos.each do |produto| %>
              <tr>
                <td class="px-4 py-3 font-medium text-stone-800"><%= produto.nome %></td>
                <td class="whitespace-nowrap px-4 py-3 text-stone-600"><%= produto.categoria_produto.nome %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= produto.preco_venda.nil? ? "—" : number_to_currency(produto.preco_venda) %></td>
                <td class="whitespace-nowrap px-4 py-3">
                  <% if produto.vendavel? %>
                    <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-800">À venda</span>
                  <% elsif produto.ativo? %>
                    <span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-800">Só estoque</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-stone-100 px-2 py-0.5 text-xs font-semibold text-stone-600">Inativo</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-right"><%= link_to "VER", produto_path(produto), class: "table-link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">Nenhum produto cadastrado.</p>
  <% end %>
</section>
