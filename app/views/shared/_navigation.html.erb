<nav aria-label="Menu principal" class="space-y-2">
  <%= link_to dashboard_path, class: "flex min-h-12 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold #{current_page?(dashboard_path) ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5 hover:text-white'}", aria: { current: current_page?(dashboard_path) ? "page" : nil } do %>
    <%= icon("dashboard") %> Dashboard
  <% end %>
  <%= link_to caixas_path, class: "flex min-h-12 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold #{current_page?(caixas_path) || controller_name == 'caixas' ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5 hover:text-white'}", aria: { current: controller_name == 'caixas' ? "page" : nil } do %>
    <%= icon("cash") %> Caixa
  <% end %>
  <%= link_to mesas_path, class: "flex min-h-12 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold #{controller_name.in?(%w[mesas comandas]) ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5 hover:text-white'}", aria: { current: controller_name.in?(%w[mesas comandas]) ? "page" : nil } do %>
    <%= icon("tables") %> Mesas
  <% end %>
  <%= link_to movimentacao_financeiras_path, class: "flex min-h-12 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold #{controller_name == 'movimentacoes' ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5 hover:text-white'}", aria: { current: controller_name == 'movimentacoes' ? "page" : nil } do %>
    <%= icon("movements") %> Movimentações
  <% end %>
  <%= link_to produtos_path, class: "flex min-h-12 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold #{controller_name == 'produtos' ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5 hover:text-white'}", aria: { current: controller_name == 'produtos' ? "page" : nil } do %>
    <%= icon("stock") %> Produtos
  <% end %>
  <%= link_to movimentacao_estoques_path, class: "flex min-h-12 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold #{controller_name == 'movimentacao_estoques' ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5 hover:text-white'}", aria: { current: controller_name == 'movimentacao_estoques' ? "page" : nil } do %>
    <%= icon("stock") %> Estoque
  <% end %>
  <%= link_to relatorios_path, class: "flex min-h-12 items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold #{controller_name == 'relatorios' ? 'bg-white/10 text-white' : 'text-white/70 hover:bg-white/5 hover:text-white'}", aria: { current: controller_name == 'relatorios' ? "page" : nil } do %>
    <%= icon("reports") %> Relatórios
  <% end %>
</nav>
