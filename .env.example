# Copy to .env.local for an existing PostgreSQL installation.
# The optional Windows local_database script generates this configuration for you.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=espetaria
PGPASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production: configure DATABASE_URL and SECRET_KEY_BASE in the hosting service.
# Also set RAILS_HOST to the exact public hostname (without https://).
# Use a new SECRET_KEY_BASE for production, never the development credentials.
# Managed PostgreSQL: validate provider CA and sslmode=verify-full at deploy.
# Tests: TEST_DATABASE_URL may override the dedicated espetaria_test database.
